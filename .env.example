OPENROUTER_API_KEY=your_openrouter_key
OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
OPENROUTER_EMBED_MODEL=openai/text-embedding-3-small

# How many characters go into one chunk when a document is split up.
# Bigger = more context per chunk, but less precise matching.
CHUNK_SIZE=1000

# How many characters of the previous chunk are repeated at the start of the next one,
# so an answer that falls on a chunk boundary doesn't get cut in half.
CHUNK_OVERLAP=200

# "top_k" - how many chunks are actually sent to the AI to answer from.
RETRIEVAL_TOP_K=3

# How many candidate chunks each search method (semantic + keyword) considers
# before they get merged and trimmed down to RETRIEVAL_TOP_K.
RETRIEVAL_POOL=15
