OPENROUTER_API_KEY=your_openrouter_key
OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
OPENROUTER_EMBED_MODEL=openai/text-embedding-3-small

# How many characters go into one chunk when a document is split up.
# Bigger = more context per chunk, but less precise matching.
CHUNK_SIZE=1000

# How many characters of the previous chunk are repeated at the start of the next one,
# so an answer that falls on a chunk boundary doesn't get cut in half.
CHUNK_OVERLAP=200

# "top_k" - how many chunks are actually sent to the AI to answer from.
RETRIEVAL_TOP_K=3

# How many candidate chunks each search method (semantic + keyword) considers
# before they get merged and trimmed down to RETRIEVAL_TOP_K.
RETRIEVAL_POOL=15

# WEEK-4 CHANGE: how many of the fused (semantic + keyword) candidates get
# sent to the reranker before it trims them down to RETRIEVAL_TOP_K. Higher
# = better chance the right chunk is in the window the reranker sees, but a
# bigger/slower/costlier rerank prompt.
RETRIEVAL_RERANK_CANDIDATES=8

# WEEK-6 CHANGE: set to true and fill in LANGSMITH_API_KEY to send every
# chat/embeddings call to LangSmith for tracing. Leave false (or leave
# LANGSMITH_API_KEY blank) to run with no LangSmith account at all -- the
# app works identically either way.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your_langsmith_key
LANGSMITH_PROJECT=rag0-sample-week6

# TEMP: alternate chat-completions provider, for when OpenRouter credits run
# out. Leave LLM_PROVIDER unset (or "openrouter") for normal operation. Set
# to "groq" to route every chat call (reranking, generation, the eval
# judge, the Week 7 agent) to Groq's free tier instead -- get a key at
# https://console.groq.com/keys. Embeddings always stay on OpenRouter
# regardless (Groq has no embeddings endpoint) -- see rag_chat/client.py.
LLM_PROVIDER=openrouter
GROQ_API_KEY=your_groq_key
GROQ_CHAT_MODEL=openai/gpt-oss-120b
